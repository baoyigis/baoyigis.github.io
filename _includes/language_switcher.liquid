<!-- Language Switcher -->
{% assign page_url = page.url %}
{% comment %} Get current language from page {% endcomment %}
{% assign current_lang = page.lang %}
{% if current_lang == null %}{% assign current_lang = site.default_lang %}{% endif %}

{% comment %} Remove language prefix from URL to get base path {% endcomment %}
{% assign base_url = page_url | remove_first: '/en' | remove_first: '/zh' %}
{% if base_url == '' or base_url == '/' %}{% assign base_url = '/' %}{% endif %}

<li class="nav-item dropdown">
  <a class="nav-link dropdown-toggle" href="#" id="langDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
    {% if current_lang == 'zh' %}
      🇨🇳 中文
    {% else %}
      🇺🇸 English
    {% endif %}
  </a>
  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="langDropdown">
    <a class="dropdown-item {% if current_lang == 'en' or current_lang == nil %}active{% endif %}" href="{{ base_url | relative_url }}">
      🇺🇸 English
    </a>
    <a class="dropdown-item {% if current_lang == 'zh' %}active{% endif %}" href="{{ '/zh' | append: base_url | relative_url }}"> 🇨🇳 中文 </a>
  </div>
</li>
